{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "resources": {
      "../dist/THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "targets": [
      "nsis"
    ],
    "shortDescription": "Configuration des claviers AKKO",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": true,
        "startMenuFolder": "Open Akko"
      },
      "wix": {
        "language": [
          "fr-FR",
          "en-US"
        ]
      }
    }
  }
}
